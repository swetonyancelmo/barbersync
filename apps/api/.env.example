# ─────────────────────────────────────────────────────────────────────────────
# Banco de dados
# Dois modos, nesta ordem de precedência:
#   1) DATABASE_URL  → produção (Neon/Render entregam a string pronta)
#   2) DB_HOST/...   → dev local (Postgres do docker-compose)
# ─────────────────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:senha@host.neon.tech/barbersync?sslmode=require

DB_HOST=localhost
# 5433 = porta publicada pelo docker-compose (container usa 5432 internamente)
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=barbersync

# TLS na conexão. Vazio/false em dev; true em produção (a Neon exige).
# Se não declarado, liga automaticamente quando DATABASE_URL não é localhost.
# DB_SSL=false

# Loga toda query do TypeORM (debug)
# DB_LOGGING=false

# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────
# NODE_ENV=production desliga o synchronize independente de DB_SYNC.
# NODE_ENV=production
PORT=3333
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────────────────────
# CORS — allowlist de origins (nunca '*', a API responde com credentials)
# ─────────────────────────────────────────────────────────────────────────────
# Produção: lista separada por vírgula, sem barra no fim.
# CORS_ORIGINS=https://barbersync-client.vercel.app,https://barbersync-admin.vercel.app

# Dev: também aceitam lista (ex.: localhost + IP da LAN p/ testar no celular).
CLIENT_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

# ─────────────────────────────────────────────────────────────────────────────
# Sincroniza schema automaticamente — APENAS dev. Em produção use migrations
# (npm run migration:run). Ignorado quando NODE_ENV=production.
# ─────────────────────────────────────────────────────────────────────────────
DB_SYNC=true

# ─────────────────────────────────────────────────────────────────────────────
# Notificações
# NOTIFICATIONS_CHANNEL: 'log' (dev, só loga) ou 'email' (envia via Resend)
# ─────────────────────────────────────────────────────────────────────────────
NOTIFICATIONS_CHANNEL=log
# Só necessários quando NOTIFICATIONS_CHANNEL=email:
RESEND_API_KEY=
MAIL_FROM=BarberSync <no-reply@barbersync.app>
APP_NAME=BarberSync

# Relatórios: fuso usado para agrupar pagamentos por dia (o Postgres roda em UTC)
REPORTS_TIMEZONE=America/Sao_Paulo
